#Para ajustar el comportamineto del servidor sin modificar la configuración principal

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  
  # Define qué recursos pueden cargarse desde dónde
  # - default-src 'self': Solo recursos del mismo origen por defecto
  # - script-src: Permite scripts propios, inline (necesario para algunos casos) y cdn.jsdelivr.net
  # - style-src: Permite estilos propios, inline, Google Fonts y cdn.jsdelivr.net
  # - font-src: Permite fuentes propias, Google Fonts y cdn.jsdelivr.net
  # - img-src: Permite imágenes propias y data URIs
  # - connect-src: Permite conexiones AJAX/fetch a origen propio y API externa
  # - frame-ancestors 'none': No permite que la página se muestre en iframes
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none';"
  
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Cache-Control: Control de caché del navegador
  <FilesMatch "\.(jpg|jpeg|png|webp|ico|mp4)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  # Comprime archivos antes de enviarlos al cliente para reducir ancho de banda
  # Reduce significativamente el tiempo de carga, especialmente en conexiones lentas
  
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
</IfModule>

<IfModule mod_expires.c>
  # Activa el sistema de expiración de archivos
  ExpiresActive On
  
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  
  ExpiresByType text/html "access plus 0 seconds"
  
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# Bloquea el listado de directorios (evita que se vea el contenido de carpetas)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "(package\.json|package-lock\.json|\.gitignore|\.gitattributes|\.env|\.htaccess|vercel\.json)$">
  Require all denied
</FilesMatch>

# Fuerza HTTPS (redirige todas las peticiones HTTP a HTTPS)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Redirige www a sin www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_mime.c>
  # Define tipos MIME para extensiones que Apache podría no reconocer
  # Asegura que el navegador interprete correctamente los archivos
  
  AddType application/javascript js
  AddType image/webp webp
</IfModule>

# Define páginas personalizadas para códigos de error HTTP
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# Define el charset por defecto para todas las respuestas
AddDefaultCharset UTF-8

# ETags: Identificadores únicos para versiones de archivos
# MTime Size: Usa fecha de modificación y tamaño para generar ETags
# Útil para validación de caché
FileETag MTime Size
